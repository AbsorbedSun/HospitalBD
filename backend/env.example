# ============================================================
# MediConnect – Variables de entorno
# ============================================================
# 1. Copia este archivo:  cp backend/.env.example backend/.env
# 2. Ajusta los valores según tu entorno
# 3. Ejecuta:             python run.py
# ============================================================

# ── Servidor Flask ───────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=True

# ── JWT ──────────────────────────────────────────────────────
# Genera una clave segura con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia_esta_clave_por_una_muy_segura
JWT_EXPIRATION_HOURS=8

# ── Base de datos SQL Server ─────────────────────────────────
# Instancia nombrada : localhost\SQLEXPRESS
# Instancia default  : localhost
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=HospitalDB
DB_PORT=1433

# ── Modo de autenticación ────────────────────────────────────
# "windows"  →  Autenticación de Windows (recomendado en equipos del dominio).
#               No requiere usuario ni contraseña.
#               El proceso Python usa las credenciales del usuario de Windows actual.
#
# "sql"      →  Autenticación SQL Server.
#               Requiere definir DB_USER y DB_PASSWORD abajo.
DB_AUTH_MODE=windows

# ── Solo necesario si DB_AUTH_MODE=sql ───────────────────────
# DB_USER=TU_USUARIOS_AQUI
# DB_PASSWORD=TU_CONTRASEÑA_AQUI